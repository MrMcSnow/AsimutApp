<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/asimut_header"
    android:gravity="center"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/footer_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:text="Von Serhii Lobazanov\ninst.: @mr.mcsnow"
            android:gravity="start" />

        <ImageButton
            android:id="@+id/about_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Öffnet den Bereich 'Über das Projekt'"
            android:padding="8dp"
            android:src="@drawable/ic_placeholder_info"
            android:tint="@android:color/white"
            android:tooltipText="Über das Projekt (замени иконку здесь)" />
    </LinearLayout>
</LinearLayout>
